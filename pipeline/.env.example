# Copia este archivo a ".env" (sin ".example") y completa los valores reales.
# ".env" nunca se sube a git (ver .gitignore).

# --- YouTube Data API v3 (OAuth "Desktop app") ---
# client_id y client_secret salen del client_secret_*.json descargado en
# Google Cloud Console (APIs y servicios > Credenciales).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Dónde se guarda el token ya autorizado. Se crea solo: la primera vez que
# subas un clip se abre el navegador para pedir permiso una vez; desde la
# segunda vez en adelante se reusa este archivo sin volver a pedir login.
YOUTUBE_TOKEN_FILE=youtube_token.json

# --- Supabase (proyecto compartido con otro uso; tabla en schema rayando_cda) ---
SUPABASE_URL=
# Service role key (NO la anon key) — necesaria para insertar en la tabla.
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram Graph API (Instagram Business Login, app "Rayando el CDA-IG") ---
# App ID / Secret salen de Meta for Developers > Casos de uso > Personalizar >
# API de Instagram > "Configuración de la API con inicio de sesión con Instagram".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Token de larga duración (60 días) de la cuenta @rayandoelcda. Se genera con
# el flujo OAuth manual (ver pipeline/README.md) y hay que renovarlo antes de
# que expire (se puede refrescar sin volver a loguear, vía
# GET https://graph.instagram.com/refresh_access_token).
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business Account ID de @rayandoelcda.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# redirect_uri usado al generar el token de arriba (debe coincidir si se
# vuelve a hacer el flujo OAuth manual).
INSTAGRAM_OAUTH_REDIRECT_URI=

# --- Resend (alertas por mail del disparador automático) ---
RESEND_API_KEY=

# --- Anthropic (detección de candidatos, copys e interpretación de
# correcciones de video, todo por IA) ---
# Usada por detectar_momentos.py, copys_ia.py e interpretar_correccion.py.
ANTHROPIC_API_KEY=

# --- TikTok Content Posting API (app "Rayando el CDA" en TikTok Developers) ---
# Client Key / Client Secret salen de developers.tiktok.com > tu app >
# Basic Information. El Client Secret es sensible, tratalo como contraseña.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Tiene que ser EXACTO al Redirect URI cargado en TikTok Developers > Login
# Kit (y aprobado en revisión) — hoy es
# https://sebapino25.github.io/rayando-cda-review/mediakit/tiktok-callback.html
TIKTOK_OAUTH_REDIRECT_URI=
# Solo hace falta para el paso manual único de autorización (ver
# pipeline/README.md, sección TikTok): tiktok_oauth_generar_url.py +
# tiktok_oauth_intercambiar_codigo.py. Una vez hecho, el access_token y el
# refresh_token quedan en rayando_cda.tiktok_token y se refrescan solos —
# estas 3 variables no hacen falta para el uso normal del pipeline.
